# Copy this file to /etc/munara/munara.env and replace every CHANGE_ME value.
DJANGO_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_50_RANDOM_CHARACTERS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=kutbilim.gps.gov.kg
CSRF_TRUSTED_ORIGINS=https://kutbilim.gps.gov.kg
CORS_ALLOWED_ORIGINS=https://kutbilim.gps.gov.kg
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# The existing project currently uses SQLite. Leave USE_POSTGRES=0 to retain it.
USE_POSTGRES=0

# Uncomment and fill these only when PostgreSQL is used.
# POSTGRES_DB=munara
# POSTGRES_USER=munara
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
